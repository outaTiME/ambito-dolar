<?xml version="1.0" encoding="utf-8"?>
<!-- the card itself, ios uses the system container so this is our equivalent. From api 31 the
     launcher masks the widget with its own radius on top of this one -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <corners android:radius="@dimen/widget_corner" />
  <solid android:color="@color/widget_background" />
</shape>
