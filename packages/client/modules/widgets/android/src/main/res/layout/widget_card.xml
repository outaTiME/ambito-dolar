<?xml version="1.0" encoding="utf-8"?>
<!-- the six ios systemSmall slots as ImageViews, the launcher only resolves system fonts so kotlin draws the text -->
<!-- as initialLayout it is the bare card, the rates are loading and not missing -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- square through the 1:1 drawable below, never stretched by a tall cell -->
  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@drawable/widget_card_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_square" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:screenReaderFocusable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding"
        android:visibility="gone">

      <ImageView
          android:id="@+id/widget_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

      <ImageView
          android:id="@+id/widget_detail"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content" />

      <!-- the gap that stretches, same as the ios Spacer -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="bottom">

        <ImageView
            android:id="@+id/widget_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/widget_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
      </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
  </FrameLayout>
</FrameLayout>
