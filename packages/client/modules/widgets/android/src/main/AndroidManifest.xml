<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- the widgets fetch on their own, the merger dedupes it against the app one -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <!-- Resources.getFont is api 26, so below it every receiver ships disabled -->
    <receiver
      android:name="im.outa.ambitodolar.widgets.RateWidget"
      android:enabled="@bool/widget_supported"
      android:exported="false"
      android:label="@string/widget_rate_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <!-- an app update re-inflates every widget bare from initialLayout -->
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_rate_info" />
    </receiver>

    <receiver
      android:name="im.outa.ambitodolar.widgets.ListWidget"
      android:enabled="@bool/widget_supported"
      android:exported="false"
      android:label="@string/widget_list_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_list_info" />
    </receiver>

    <receiver
      android:name="im.outa.ambitodolar.widgets.SpreadWidget"
      android:enabled="@bool/widget_supported"
      android:exported="false"
      android:label="@string/widget_spread_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_spread_info" />
    </receiver>

    <receiver
      android:name="im.outa.ambitodolar.widgets.MarketWidget"
      android:enabled="@bool/widget_supported"
      android:exported="false"
      android:label="@string/widget_market_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_market_info" />
    </receiver>

    <receiver
      android:name="im.outa.ambitodolar.widgets.MarketListWidget"
      android:enabled="@bool/widget_supported"
      android:exported="false"
      android:label="@string/widget_market_list_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_market_list_info" />
    </receiver>

    <!-- one screen for every widget, which one comes from the id it was launched with -->
    <activity
      android:name="im.outa.ambitodolar.widgets.WidgetConfigActivity"
      android:enabled="@bool/widget_supported"
      android:exported="true"
      android:theme="@style/Theme.Widget.Config">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

  </application>
</manifest>
